<section
	id="portfolio"
	class="projects text-light text-center bg-1 pb-5">
	<div class="container pt-5">
		<h1
			class="section-header mt-sm-5 d-flex justify-content-center align-items-center p-5 fw-bold display-4 mb-3 mb-xl-5"
			data-aos="fade-up">
			Portfolio
		</h1>
	</div>
	<div class="container d-flex flex-column pb-5 mb-5 fs-4">
		<div
			class="animated animated__cards mt-xl-2 mx-2 mb-xl-5 px-xxl-5"
			data-aos="fade-up">
			<div
				class="p-card-psvita projects-card animated__card"
				tabindex="0">
				<div class="front front-rotate p-5">
					<h2 class="mb-5 fw-bold fs-1">PS Vita Demo Blog</h2>
					<p>A blog focused on the portable Sony PlayStation Vita console.</p>
					<div class="d-xxl-none btn btn-outline-light mt-4 position-relative">
						<div
							class="btn btn-outline-light h-100 w-100 position-absolute top-0 start-0 p-0 m-0 ping"></div>
						<p class="m-0 p-2 fs-5 text-uppercase">See more</p>
					</div>
				</div>
				<div class="back back-rotate back--psvita">
					<div class="d-flex justify-content-center display-3 back-links">
						<a
							href="https://psvita.free.nf/"
							target="_blank"
							rel="noopener">
							<div class="d-flex flex-column m-5">
								<i class="icon-share-nodes-solid"></i>
								<p class="fs-4 mt-3">Visit the site</p>
							</div>
						</a>
					</div>
					<h3 class="m-3 m-xl-4 mb-xl-5 fw-bold fs-1">PS Vita Demo Blog</h3>
					<p>A blog focused on the portable Sony PlayStation Vita console.</p>
				</div>
			</div>

			<div
				class="p-card-todo projects-card animated__card d-none"
				tabindex="0">
				<div class="front front-rotate p-5">
					<h2 class="mb-5 fw-bold fs-1">ToDoList</h2>
					<p>
						A simple ToDoList application developed in React.js with the
						functionality of saving tasks in the browser's local storage.
					</p>
					<div class="d-xxl-none btn btn-outline-light mt-4 position-relative">
						<div
							class="btn btn-outline-light h-100 w-100 position-absolute top-0 start-0 p-0 m-0 ping"></div>
						<p class="m-0 p-2 fs-5 text-uppercase">See more</p>
					</div>
				</div>
				<div class="back back-rotate back--todo">
					<div class="d-flex justify-content-center display-3 back-links">
						<a
							href="https://sd91pl.github.io/ToDoList/"
							target="_blank"
							rel="noopener">
							<div class="d-flex flex-column m-5">
								<i class="icon-share-nodes-solid"></i>
								<p class="fs-4 mt-3">App</p>
							</div>
						</a>
						<a
							href="https://github.com/SD91PL/ToDoList"
							target="_blank"
							rel="noopener">
							<div class="d-flex flex-column m-5">
								<i class="icon-github"></i>
								<p class="fs-4 mt-3">Repo</p>
							</div>
						</a>
					</div>
					<h3 class="m-3 m-xl-4 mb-xl-5 fw-bold fs-1">ToDoList</h3>
					<p>
						A simple ToDoList application developed in React.js with the
						functionality of saving tasks in the browser's local storage.
					</p>
				</div>
			</div>

			<div
				class="p-card-carsspot projects-card animated__card d-none"
				tabindex="0">
				<div class="front front-rotate p-5">
					<h2 class="mb-5 fw-bold fs-1">CarsSpot</h2>
					<p>
						The CarsSpot website developed as part of the recruitment process
						for adSite.pro based on the received mockup in Figma.
					</p>
					<div class="d-xxl-none btn btn-outline-light mt-4 position-relative">
						<div
							class="btn btn-outline-light h-100 w-100 position-absolute top-0 start-0 p-0 m-0 ping"></div>
						<p class="m-0 p-2 fs-5 text-uppercase">See more</p>
					</div>
				</div>
				<div class="back back-rotate back--carsspot">
					<div class="d-flex justify-content-center display-3 back-links">
						<a
							href="https://sd91pl.github.io/CarsSpot/"
							target="_blank"
							rel="noopener">
							<div class="d-flex flex-column m-5">
								<i class="icon-share-nodes-solid"></i>
								<p class="fs-4 mt-3">Site</p>
							</div>
						</a>
						<a
							href="https://github.com/SD91PL/CarsSpot"
							target="_blank"
							rel="noopener">
							<div class="d-flex flex-column m-5">
								<i class="icon-github"></i>
								<p class="fs-4 mt-3">Repo</p>
							</div>
						</a>
					</div>
					<h3 class="m-3 m-xl-4 mb-xl-5 fw-bold fs-1">CarsSpot</h3>
					<p>
						The CarsSpot website developed as part of the recruitment process
						for adSite.pro based on the received mockup in Figma.
					</p>
				</div>
			</div>

			<div
				class="p-card-drop projects-card animated__card d-none"
				tabindex="0">
				<div class="front front-rotate p-5">
					<h2 class="mb-5 fw-bold fs-1">Drop - Menu</h2>
					<p>
						Next.js application project developed for the recruitment process at
						droplo.com
					</p>
					<div class="d-xxl-none btn btn-outline-light mt-4 position-relative">
						<div
							class="btn btn-outline-light h-100 w-100 position-absolute top-0 start-0 p-0 m-0 ping"></div>
						<p class="m-0 p-2 fs-5 text-uppercase">See more</p>
					</div>
				</div>
				<div class="back back-rotate back--drop">
					<div class="d-flex justify-content-center display-3 back-links">
						<a
							href="https://drop-menu.vercel.app/"
							target="_blank"
							rel="noopener">
							<div class="d-flex flex-column m-5">
								<i class="icon-share-nodes-solid"></i>
								<p class="fs-4 mt-3">Site</p>
							</div>
						</a>
						<a
							href="https://github.com/SD91PL/drop-menu"
							target="_blank"
							rel="noopener">
							<div class="d-flex flex-column m-5">
								<i class="icon-github"></i>
								<p class="fs-4 mt-3">Repo</p>
							</div>
						</a>
					</div>
					<h3 class="m-3 m-xl-4 mb-xl-5 fw-bold fs-1">Drop - Menu</h3>
					<p>
						Next.js application project developed for the recruitment process at
						droplo.com
					</p>
				</div>
			</div>
		</div>
		<div
			class="projects-btns pb-3 pb-sm-5 mx-2 mx-sm-3 mx-xxl-5"
			data-aos="fade-up">
			<button
				class="p-btn-psvita projects-btn btn btn-outline-light mt-4 mx-2 mx-sm-3 btn-active">
				<p class="m-0 p-2 fs-4">PS Vita Demo Blog - WordPress</p>
			</button>
			<button
				class="p-btn-todo projects-btn btn btn-outline-light mt-4 mx-2 mx-sm-3">
				<p class="m-0 p-2 fs-4">ToDoList - React.js, TailwindCSS</p>
			</button>
			<button
				class="p-btn-carsspot projects-btn btn btn-outline-light mt-4 mx-2 mx-sm-3">
				<p class="m-0 p-2 fs-4">CarsSpot - React.js, TailwindCSS</p>
			</button>
			<button
				class="p-btn-drop projects-btn btn btn-outline-light mt-4 mx-2 mx-sm-3">
				<p class="m-0 p-2 fs-4">Drop-Menu - Next.js, TailwindCSS</p>
			</button>
		</div>
	</div>
</section>
