<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0" />

		<!-- Primary SEO -->
		<title>Stanisław Dziuba – React Frontend Developer | SD91PL</title>
		<meta
			name="description"
			content="React Frontend Developer creating fast websites with high PageSpeed Insights scores. View portfolio, tech stack and get in touch – SD91PL." />
		<meta
			name="robots"
			content="index, follow" />
		<link
			rel="canonical"
			href="https://sd91pl.github.io/info/" />

		<!-- Open Graph (Facebook, LinkedIn, Discord, Slack, iMessage) -->
		<meta
			property="og:type"
			content="website" />
		<meta
			property="og:url"
			content="https://sd91pl.github.io/info/" />
		<meta
			property="og:title"
			content="Stanisław Dziuba – React Frontend Developer | SD91PL" />
		<meta
			property="og:description"
			content="I build fast, modern React websites with excellent PageSpeed Insights scores. Check out my portfolio and tech stack." />
		<meta
			property="og:image"
			content="https://sd91pl.github.io/info/dist/img/og-image.png" />
		<meta
			property="og:image:width"
			content="1200" />
		<meta
			property="og:image:height"
			content="630" />
		<meta
			property="og:image:alt"
			content="SD91PL – React Frontend Developer Portfolio" />
		<meta
			property="og:site_name"
			content="SD91PL" />
		<meta
			property="og:locale"
			content="en_US" />

		<!-- Twitter / X Cards -->
		<meta
			name="twitter:card"
			content="summary_large_image" />
		<meta
			name="twitter:title"
			content="Stanisław Dziuba – React Frontend Developer | SD91PL" />
		<meta
			name="twitter:description"
			content="I build fast, modern React websites with excellent PageSpeed Insights scores. Check out my portfolio and tech stack." />
		<meta
			name="twitter:image"
			content="https://sd91pl.github.io/info/dist/img/og-image.png" />

		<!-- Favicon (optional) -->
		<link
			rel="icon"
			href="/favicon.ico"
			type="image/x-icon" />
		<link
			rel="apple-touch-icon"
			href="/apple-touch-icon.png" />

		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "Person",
				"name": "Stanisław Dziuba",
				"alternateName": "SD91PL",
				"url": "https://sd91pl.github.io/info/",
				"jobTitle": "React Frontend Developer",
				"description": "Frontend developer specializing in React and high-performance websites with excellent PageSpeed Insights scores.",
				"knowsAbout": [
					"React",
					"Frontend Development",
					"Web Performance",
					"JavaScript",
					"UX/UI Design"
				],
				"sameAs": [
					"https://github.com/sd91pl"
					"https://www.linkedin.com/in/sd91pl/"
				]
			}
		</script>

		<!-- @include 'styles.kit' -->
	</head>
	<body
		data-bs-spy="scroll"
		data-bs-target="#navId">
		<!-- @include 'header.kit' -->
		<!-- @include 'nav.kit' -->
		<main>
			<!-- @include 'home.kit' -->
			<!-- @include 'hero.kit' -->
			<!-- @include 'stack.kit' -->
